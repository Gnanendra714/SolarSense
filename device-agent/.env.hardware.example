# Select hardware mode only after sensors are wired and verified.
SENSOR_MODE=hardware

# INA219: confirm the physical shunt marking before changing this value.
# 0.1 ohm is common, but must be verified on your exact module.
INA219_SHUNT_OHMS=0.1
INA219_MAX_EXPECTED_AMPS=0.82
I2C_BUS=1
INA219_ADDRESS=0x40
BH1750_ADDRESS=0x23

# Leave DS18B20_ID blank if exactly one 28-* probe is connected.
DS18B20_ID=
W1_BASE_DIR=/sys/bus/w1/devices

# Keep your existing device, database and cloud-sync settings:
# DEVICE_ID=solar-panel-01
# SAMPLE_INTERVAL_SECONDS=10
# DATABASE_PATH=data/solarsense_device.db
# API_BASE_URL=https://your-service/api/v1
# DEVICE_API_KEY=...
# SYNC_INTERVAL_SECONDS=15
# SYNC_BATCH_SIZE=100
# HTTP_TIMEOUT_SECONDS=10
