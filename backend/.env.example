# Copy to .env for local development. Never commit real secrets.
# Local SQLite; Render injects its managed PostgreSQL connection URL.
DATABASE_URL=sqlite:///./data/solarsense.db

# Comma-separated exact dashboard origins. Add the production Vercel URL in Render.
CORS_ORIGINS=http://localhost:5173

# Use separate random secrets for device ingestion and admin-only actions.
DEVICE_API_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-different-long-random-secret

ENVIRONMENT=development
MAX_PANEL_TEMP_C=65
MIN_LIGHT_FOR_OUTPUT_LUX=8000
MIN_POWER_RATIO=0.20
